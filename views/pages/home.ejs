<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Bootstrap demo</title>
    <link href="../bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="../css/style.css" rel="stylesheet" />
  </head>
  <body>
    <div hidden id="noItems" class="text-center position-absolute w-100" style="top:18vh">
      <div class="fs-4 text-body-tertiary">No items here</div>
      <img class="w-25 opacity-25 mt-4" style="min-width:200px; max-width:300px; -webkit-filter: grayscale(100%); filter: grayscale(100%);" src="/images/WebbedLogo.png">
    </div>
    <div hidden id="feedSpinner" class="d-flex mb-4 justify-content-center">
      <div class="spinner-border" role="status">
        <span class="visually-hidden">Loading...</span>
      </div>
    </div>
    <div class="container text-center mb-5 d-none d-md-block">
      <div id="feed-container-desktop" class="row">
        <div class="d-flex justify-content-center"></div>
      </div>
    </div>
    <div
      class="container text-center d-block d-md-none"
      id="feed-container-mobile"
      style="margin-bottom: 10vh"
    >
      <div class="row">
        <div class="d-flex justify-content-center"></div>
      </div>
    </div>
    <footer>
      <script src="../bootstrap/js/bootstrap.bundle.min.js"></script>
      <script src="../js/home/utility.js"></script>
      <script src="../js/home/setup.js"></script>
      <script src="../js/home/feedsLoad.js"></script>
      <script src="../js/home/feedsDisplay.js"></script>
      <script src="../js/home/mobileTouch.js"></script>
      <script src="../js/settings.js"></script>
    </footer>
  </body>
</html>
