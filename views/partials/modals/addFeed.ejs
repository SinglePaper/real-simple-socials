<div class="modal fade" id="addFeedModal" tabindex="-1" aria-labelledby="addFeedModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
      <div class="modal-header">
          <h1 class="modal-title fs-5" id="addFeedModalLabel">
            Add New Feed 
            <a href="/tutorial#getting-started" target="_blank">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-question-circle ms-1" viewBox="0 0 16 16">
                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                    <path d="M5.255 5.786a.237.237 0 0 0 .241.247h.825c.138 0 .248-.113.266-.25.09-.656.54-1.134 1.342-1.134.686 0 1.314.343 1.314 1.168 0 .635-.374.927-.965 1.371-.673.489-1.206 1.06-1.168 1.987l.003.217a.25.25 0 0 0 .25.246h.811a.25.25 0 0 0 .25-.25v-.105c0-.718.273-.927 1.01-1.486.609-.463 1.244-.977 1.244-2.056 0-1.511-1.276-2.241-2.673-2.241-1.267 0-2.655.59-2.75 2.286m1.557 5.763c0 .533.425.927 1.01.927.609 0 1.028-.394 1.028-.927 0-.552-.42-.94-1.029-.94-.584 0-1.009.388-1.009.94"/>
                </svg>
            </a>
          </h1>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div id="addFeedModalBody" class="modal-body">
        <label for="sourcePicker" class="text-center w-100 mb-2">Pick a source</label>
        <div id="sourcePicker" class="d-flex justify-content-center gap-3 w-100">
          <button disabled class="btn source-btn btn-outline-danger rounded-circle d-inline-flex align-items-center justify-content-center overflow-hidden p-2"
              style="width:48px;height:48px;"
              onclick="updateAddFeedForm('youtube', this)">
              <img src="../images/favicon_yt.png" class="d-block w-100 h-100 object-fit-contain" alt="Logo">
          </button>
          <button disabled class="btn source-btn btn-outline-warning rounded-circle d-inline-flex align-items-center justify-content-center overflow-hidden p-2"
              style="width:48px;height:48px;"
              onclick="updateAddFeedForm('dropout', this)">
              <img src="../images/favicon_dropout.png" class="rounded-circle d-block w-100 h-100 object-fit-contain" alt="Logo">
          </button>
          <button disabled class="btn source-btn btn-outline-primary rounded-circle d-inline-flex align-items-center justify-content-center overflow-hidden p-2"
              style="width:48px;height:48px;"
              onclick="updateAddFeedForm('nebula', this)">
              <img src="../images/favicon_nebula.png" class="d-block w-100 h-100 object-fit-contain" alt="Logo">
          </button>
          <button disabled class="btn source-btn btn-outline-contrast rounded-circle d-inline-flex align-items-center justify-content-center overflow-hidden p-2"
              style="width:48px;height:48px;"
              onclick="updateAddFeedForm('twitch', this)">
              <img src="../images/favicon_twitch.png" class="d-block w-100 h-100 object-fit-contain" alt="Logo">
          </button>
          <button disabled class="btn source-btn btn-outline-info rounded-circle d-inline-flex align-items-center justify-content-center overflow-hidden p-2"
              style="width:48px;height:48px;"
              onclick="updateAddFeedForm('bluesky', this)">
              <img src="../images/favicon_bsky.png" class="d-block w-100 h-100 object-fit-contain" alt="Logo">
          </button>             
          <button disabled class="btn source-btn btn-outline-contrast rounded-circle d-inline-flex align-items-center justify-content-center overflow-hidden p-2"
              style="width:48px;height:48px;"
              onclick="updateAddFeedForm('other', this)">
              <large><b>...</b></large>
          </button>
        </div>
        <form hidden id="addFeedForm">
          <div id="addFeedFormInputs" class="form-group mt-3">
            <div class="other">
              <label class="url-label">Feed URL (<a class="text-primary" href="/tutorial#adding-other-feeds" target="_blank">How can I find this?</a>)</label>
              <input class="form-control url"  
                placeholder="https://...">
            </div>
            <div class="youtube">
              <label class="mt-2 url-label">Channel or Playlist URL</label>
              <input class="form-control url"  
                placeholder="https://...">
              <input class="form-check-input" type="checkbox" value="" id="checkShorts">
              <label class="form-check-label" for="checkShorts">
                Include Shorts
              </label>
            </div>
            <div class="nebula">
              <label class="mt-2 url-label">Channel or Category URL</label>
              <input class="form-control url"  
                placeholder="https://...">
              <input class="form-check-input" type="checkbox" value="" id="checkPlus">
              <label class="form-check-label" for="checkPlus">
                Nebula Plus only
              </label>
            </div>
            <div class="twitch bluesky">
              <label class="url-label">Channel URL</label>
              <input class="form-control url"  
                placeholder="https://...">
            </div>
            <div class="dropout">
              <label class="mt-2">Select Show</label>
              <select id="selectDropoutSources" class="form-select">
              </select>
            </div>
            <div class="youtube dropout nebula twitch bluesky other">
              <label class="mt-2">Folder</label>
              <select id="addFeedFolders" class="form-select">
              </select>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
          <button type="button" data-bs-dismiss="modal" class="btn btn-danger">Cancel</button>
          <button disabled type="button" id="addFeedBtn" data-bs-dismiss="modal" class="btn btn-primary">Add</button>
      </div>
      </div>
  </div>
</div>