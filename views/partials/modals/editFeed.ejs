<div class="modal fade" id="editFeedModal" tabindex="-1" aria-labelledby="editFeedModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
        <div class="modal-header">
            <h1 class="modal-title fs-5" id="addFeedModalLabel">Edit Feed</h1>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div id="editFeedModalBody" class="modal-body">
        <form id="editFeedForm">
            <div id="editFeedFormInputs" class="form-group">
            <div class="all">
                <label class="url-label">Display Name</label>
                <input class="form-control name">
            </div>
            <div class="youtube youtubeShorts">
                <input class="form-check-input" type="checkbox" value="" id="editCheckShorts">
                <label class="form-check-label" for="editCheckShorts">
                Include Shorts
                </label>
            </div>
            <div class="nebula">
                <input class="form-check-input" type="checkbox" value="" id="editCheckPlus">
                <label class="form-check-label" for="editCheckPlus">
                Nebula Plus only
                </label>
            </div>

            <div class="all">
                <label class="mt-2">Folder</label>
                <select id="editFeedFolders" class="form-select">
                </select>
            </div>
            <label class="url-label mt-2">Feed URL</label>
            <div class="input-group all">
                <input readonly class="form-control url"  
                placeholder="https://..." id="editModalFeedUrl">
                <button class="btn btn-outline-secondary" type="button" onclick="copyUrlToClipboard()">Copy</button>
            </div>
            </div>
        </form>
        </div>
        <div class="modal-footer">
            <button type="button" data-bs-dismiss="modal" onclick="deleteFeed(document.getElementById('editFeedModal').getAttribute('label'))" class="btn btn-danger">Delete</button>
            <button disabled type="button" id="editFeedBtn" data-bs-dismiss="modal" onclick="editFeed(document.getElementById('editFeedModal').getAttribute('label'))" class="btn btn-primary">Save</button>
        </div>
        </div>
    </div>
</div>